@startuml
title Normal and cookie TTC negotiation
hide footbox
participant Instantiator as I
participant Negotiator as N
participant negotiationSetup as Setup
participant Shelf
participant MessageStreamer as S
participant "Negotiated information cache" as Cache
database "Oracle Database" as DB

I -> N : Negotiate(ctx)
N -> Setup : Init()
Setup -> Shelf : register default universal and native message marshallers
Setup --> N : shelf, session context, streamer, initial factory

alt Cookie negotiation
    N -> N : reconstruct PRO; prepare DTY from cached capabilities
    N -> S : Push(PRO); Push(COOKIE); Push(DTY)
    N -> Setup : configureNegotiation(cached PRO, prepared DTY)
    N -> S : register DTY pre/post decode callbacks
    N --> I : session context, shelf, nil cookie
    note over I,DB
    Authentication appends its first request and flushes.
    DTY callbacks use cached capabilities and store the received time-zone version.
    The instantiator removes these callbacks when authentication returns.
    end note
else Normal or recovery negotiation
    alt Fresh normal connection
        N -> S : send TTIPRO
        S -> DB : TTIPRO
        DB --> S : TTIPRO
    else Recovery after TTIRENEG
        N -> S : read pending TTIPRO without sending a new request
        DB --> S : replacement TTIPRO
    end
    S --> N : decoded PRO
    N -> Shelf : register server capabilities
    N -> N : _negotiateDatatype(PRO)
    N -> S : send TTIDTY
    S -> DB : TTIDTY
    DB --> S : TTIDTY
    S --> N : decoded DTY
    N -> Setup : configureNegotiation(PRO, DTY)
    N -> N : store DTY time-zone version; snapshot cookie from PRO
    N --> I : session context, shelf, cookie
    opt Property enabled and nonblank database UUID
        I -> Cache : Put(databaseUUID, cookie)
    end
    note over I,DB
    Cache population follows successful negotiation, before authentication.
    Failed negotiation returns an error without replacing the cache entry.
    end note
end
@enduml
